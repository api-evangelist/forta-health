                "name": "cohort_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update Cohort"
        },
        {
          "info": {
            "name": "Delete Cohort",
            "type": "http"
