          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/cohorts/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Cohort"
        },
        {
          "info": {
            "name": "Fetch Cohort",
            "type": "http"
          },
          "http": {
