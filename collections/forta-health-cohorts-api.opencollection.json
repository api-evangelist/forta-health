          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cohorts/service_classes/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch Cohort Service Classes"
